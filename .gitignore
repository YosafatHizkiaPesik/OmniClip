# Python
__pycache__/
*.py[cod]
*$py.class
backend/venv/
backend/__pycache__/
backend/*.log
*.env

# Node / React
node_modules/
frontend/node_modules/
frontend/dist/
frontend/*.log
.DS_Store

# Berkas video yang dijatuhkan di akar repo untuk ditinjau (hasil render yang
# dikirim pengguna). Bukan artefak proyek, dan ukurannya puluhan megabita.
/*.mp4

# Media Storage
# Bobot model yang diunduh aplikasi saat pertama dipakai. Saat OmniClip
# dijalankan sebagai aplikasi terbungkus, foldernya pindah ke sini karena
# folder aplikasi tidak bisa ditulis.
OmniClip_Storage/models/
OmniClip_Storage/.env
OmniClip_Storage/local_downloads/*
OmniClip_Storage/edited_clips/*
OmniClip_Storage/logs/*
OmniClip_Storage/thumbnails/*
OmniClip_Storage/title_voice/*
OmniClip_Storage/*.db
OmniClip_Storage/*.db-wal
OmniClip_Storage/*.db-shm

# Kredensial Google. Berkas client secret dan token penyegar keduanya cukup
# untuk mengunggah ke kanal YouTube pemiliknya — keduanya tidak boleh masuk
# riwayat git, termasuk bila repo ini nanti dijadikan publik.
OmniClip_Storage/google_client_secret.json
OmniClip_Storage/google_token.json
!OmniClip_Storage/**/.gitkeep
backend/models/campplus_sv.onnx
# Pengenal wajah SFace: 37 MB. Yang membuat nomor orang menunjuk ORANG dan
# bukan kursi, jadi ia penting — tapi bobot model tetap tidak masuk riwayat git.
backend/models/face_recognition_sface_2021dec.onnx
# Pendengar peristiwa suara YAMNet (tawa, sorak, teriak): 16 MB, diunduh saat
# pertama dipakai sutradara bingkai.
backend/models/yamnet.onnx
# Suara Piper untuk membacakan judul klip: 63 MB, diunduh sekali saat pertama
# dipakai. Bobot model tidak masuk riwayat git — YuNet (232 KB) ikut karena
# kecil dan tanpa itu bingkai otomatis tidak bisa jalan sama sekali.
backend/models/tts/

# Impeccable: potret pemeriksaan dan mockup keputusan (bukan artefak kirim)
.impeccable/mocks/
frontend/.impeccable/review/

# Aplikasi desktop: artefak pembungkusan.
#
# backend/bin/ berisi ffmpeg dan ffprobe statis (160 MB) yang diunduh
# tools/ambil_ffmpeg.py. Ia bagian dari HASIL build, bukan dari sumbernya.
backend/bin/
backend/build/
backend/dist/

# Pustaka yang diperbarui sendiri saat aplikasi berjalan (lihat
# backend/app/services/pustaka.py). Isinya wheel dari PyPI, bukan kode proyek.
OmniClip_Storage/pustaka/
# Salinan analisis 1280 px (services/proksi.py) - ratusan MB per video.
OmniClip_Storage/proksi/
OmniClip_Storage/suara/
# Berkas yang diimpor ke Studio dan efek suara yang dibangkitkan.
OmniClip_Storage/aset/

# Alat pihak ketiga yang diunduh saat aplikasi berjalan (services/alat_yt.py):
# runtime JavaScript Deno dan penyedia PO Token bgutil, ±140 MB. Keduanya
# berlisensi sendiri dan sengaja TIDAK dibundel — diunduh dari rilis resminya
# dengan versi dan SHA-256 yang dipatok.
OmniClip_Storage/alat/
# Berkas video milik pengguna yang diimpor dari komputernya.
OmniClip_Storage/impor/
# Cadangan basis data sebelum migrasi.
OmniClip_Storage/*.db.cadangan*

# Font aksara non-Latin yang diunduh saat dipakai (services/fonts.py), 4-8 MB.
backend/app/assets/fonts/NotoSans*
OmniClip_Storage/fonts/

# Cadangan basis data (services/pemeliharaan.py) — puluhan MB per berkas.
OmniClip_Storage/cadangan/
